    "desktop": {
      "_note": "Any Linux laptop or PC with a desktop (X11 or Wayland), e.g. a Pinebook or an old Atom netbook. Software decoding with automatic safe hardware decoding when the machine has it (VA-API). Starts fullscreen the first time (f toggles), then remembers the window. UNTESTED on real Linux hardware; for a weak CPU or old Intel graphics use desktop-lite.",
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--title=${force-media-title}",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=spelunkr-pi-client/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--demuxer-max-bytes=64MiB",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94",
        "--autofit=60%",
        "--auto-window-resize=no",
        "--hwdec=auto-safe",
        "--vd-lavc-threads=0",
        "--framedrop=vo"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=192x144:r=15,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=320x240:r=5",
      "remember_window": true,
      "fullscreen_first_run": true
    },
    "desktop-lite": {
      "_note": "For weak laptops (Atom N270 netbooks, 800 MHz CPUs): software decode with the cheaper settings (skips the loop filter on non-reference frames, fast decoding tricks) and the Xv video output, which uses the X server's own scaler instead of OpenGL (old Intel GPUs cannot run mpv's gpu output well). Needs X11. Console-only? replace --vo=xv with --vo=drm. UNTESTED.",
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--title=${force-media-title}",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=spelunkr-pi-client/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94",
        "--autofit=60%",
        "--auto-window-resize=no",
        "--vd-lavc-threads=0",
        "--hwdec=no",
        "--vo=xv",
        "--vd-lavc-skiploopfilter=nonref",
        "--vd-lavc-fast",
        "--framedrop=decoder+vo",
        "--cache-secs=20",
        "--demuxer-max-bytes=24MiB"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=192x144:r=15,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=320x240:r=5",
      "remember_window": true,
      "fullscreen_first_run": true
