{
  "profile": "mac",
  "cache_dir": "~/.cache/spelunkr",
  "lineup_refresh_s": 600,
  "start_channel": 13,
  "drift_s": 4,
  "drift_check_s": 20,
  "bar_seconds": 6,
  "bumps": true,
  "noise": "lavfi",
  "noise_seconds": 1.2,
  "digit_timeout_s": 1.5,
  "retry_backoff_s": [
    2,
    5,
    10,
    20
  ],
  "profiles": {
    "mac": {
      "mpv": [
        "mpv",
        "--idle=yes",
        "--force-window=yes",
        "--no-terminal",
        "--no-config",
        "--osc=no",
        "--input-ipc-server={sock}",
        "--input-conf={inputconf}",
        "--no-input-default-bindings",
        "--title=${force-media-title}",
        "--geometry=720x540",
        "--auto-window-resize=no",
        "--keep-open=no",
        "--audio-display=no",
        "--user-agent=spelunkr-pi-client/0.1 (personal, non-commercial)",
        "--network-timeout=30",
        "--cache=yes",
        "--demuxer-max-bytes=64MiB",
        "--ytdl=no",
        "--sub-auto=no",
        "--sub-font-size=42",
        "--sub-border-size=2.5",
        "--sub-pos=94"
      ],
      "noise_graph": "av://lavfi:nullsrc=s=192x144:r=15,geq=random(1)*255:128:128",
      "black_graph": "av://lavfi:color=c=black:s=320x240:r=5"
    },
    "pi": {
      "_note": "Measured on a Pi 2: --vo=gpu --gpu-context=drm --profile=fast plays smoothly with hardware decode (v4l2m2m-copy); --vo=drm (CPU scaling) was too slow at HDMI resolutions. Not yet tested on composite or a Pi 1.",
      "mpv": [
